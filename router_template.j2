! สร้าง VRF
ip vrf {{ vrf_name }}
exit

! จัดการ OSPF
no router ospf {{ ospf_process }}
router ospf {{ ospf_process }} vrf {{ vrf_name }}
{% if is_r2 %}
default-information originate always
{% endif %}
exit

! จัดการ Interface ด้วยการวนลูป
{% for intf in interfaces %}
interface {{ intf.name }}
 ip vrf forwarding {{ vrf_name }}
 {% if intf.ip is defined %}
 ip address {{ intf.ip }} {{ intf.mask }}
 {% endif %}
 ip ospf {{ ospf_process }} area {{ ospf_area }}
 {% if intf.nat is defined %}
 ip nat {{ intf.nat }}
 {% endif %}
exit
{% endfor %}

! Access-List สำหรับ VTY
ip access-list standard VTY_ACCESS
permit 172.31.111.0 0.0.0.15
permit 10.30.6.0 0.0.0.255
exit

line vty 0 4
access-class VTY_ACCESS in vrf-also
line vty 5 15
access-class VTY_ACCESS in vrf-also
exit